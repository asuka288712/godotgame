; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="仙剑奇侠传 - HD-2D重制版Demo"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/game_data.gd"
DialogueSystem="*res://scripts/dialogue_system.gd"
BattleSystem="*res://scripts/battle_system.gd"
SaveManager="*res://scripts/save_manager.gd"
GlobalMenu="*res://scripts/ui/global_menu.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
StoryManager="*res://scripts/story/story_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="仙剑奇侠传 - HD-2D重制版Demo"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[mcp_toolkit]

status="No .mcp.json found — use Project > Tools > MCP Toolkit > Write .mcp.json to create one."

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/hdr_2d=false
